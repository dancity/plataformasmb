# Só é preciso preencher para apontar um build a OUTRO projeto Firebase
# (homologação). Sem estas variáveis, o app usa o projeto plataformas-marista,
# cujos valores estão em src/lib/firebase.ts — configuração web do Firebase é
# pública por natureza e não autoriza nada sozinha.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# ID do tenant do Entra ID. Sem ele, o login Microsoft aceita qualquer conta
# corporativa; com ele, só a da organização.
# VITE_MS_TENANT_ID=

# Emuladores locais. Nunca ligar por detecção de hostname.
# VITE_USAR_EMULADORES=true
